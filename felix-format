#!/usr/bin/env python3
"""felix-format: clang-format + Felix's airy paragraph spacing.

Completly made by AI because wth is python and tf im not wasting my time on formatting my code lmao

Usage:
  felix-format [-i] [--check] [--diff] [--no-clang] file [file ...]
  felix-format < file.c            # stdin -> stdout

Pipeline per file: dependency-safe include normalization -> clang-format with
Felix's built-in style -> designated-initializer expansion -> airy blank-line
pass.

The formatter is intentionally self-contained: it does not depend on a repo
.clang-format file, and clang-format is never allowed to sort includes.
"""
import argparse
import difflib
import os
import re
import subprocess
import sys

CONTROL = ("if", "for", "while", "switch", "return", "break", "continue", "goto")
CONTROL_RE = re.compile(r"^(if|for|while|switch|return|break|continue|goto)\b")
HEADER_RE = re.compile(r"^(if|for|while|switch|else|do)\b")
CASE_RE = re.compile(r"^(case\b|default\b)")
DECL_RE = re.compile(
    r"^\s*(?:(?:const|static|extern|register|volatile|inline|_Atomic"
    r"|unsigned|signed|long|short)\s+)*"
    r"[A-Za-z_]\w*"
    r"(?:\s+[A-Za-z_]\w*)?"
    r"\s*\**\s*"
    r"(?P<name>[A-Za-z_]\w*)"
    r"\s*(?:\[[^\]]*\]\s*)*"
    r"\s*(?:=|;)"
)

FELIX_STYLE = """{
BasedOnStyle: LLVM,
Standard: Latest,
ColumnLimit: 180,
IndentWidth: 4,
TabWidth: 4,
ContinuationIndentWidth: 4,
UseTab: Never,
BreakBeforeBraces: Attach,
AllowShortIfStatementsOnASingleLine: AllIfsAndElse,
AllowShortFunctionsOnASingleLine: Empty,
AllowShortBlocksOnASingleLine: Never,
AllowAllParametersOfDeclarationOnNextLine: true,
AllowAllArgumentsOnNextLine: true,
BinPackParameters: false,
BinPackArguments: false,
DerivePointerAlignment: false,
PointerAlignment: Right,
ReferenceAlignment: Right,
AlignAfterOpenBracket: BlockIndent,
AlignOperands: Align,
SpaceBeforeParens: ControlStatements,
SpaceAfterCStyleCast: false,
SpaceBeforeCpp11BracedList: false,
Cpp11BracedListStyle: true,
SortIncludes: false,
IncludeBlocks: Preserve,
MaxEmptyLinesToKeep: 2,
IndentCaseLabels: true,
IndentGotoLabels: false,
ReflowComments: false,
BreakBeforeBinaryOperators: None
}""".replace("\n", " ")

# A line ending in ';', '{', '}' or ':' is a complete statement boundary.
# Anything else (operators, commas, openers) means the statement continues.
CONT_START = (
    "?", ":", ",", ".", ")", "]", "*", "&", "|", "^", "%", "+",
    "-", "/", "<", ">", "=", "!",
)


def strip_code(s):
    """Remove string/char literals and // comments for brace counting."""
    out = []
    i, n = 0, len(s)
    quote = None
    while i < n:
        c = s[i]
        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c in ("'", '"'):
            quote = c
            i += 1
            continue
        if c == "/" and i + 1 < n and s[i + 1] == "/":
            break
        out.append(c)
        i += 1
    return "".join(out)


def is_blank(s):
    return s.strip() == ""


def is_preproc(s):
    return s.lstrip().startswith("#")


def is_comment_only(s):
    t = s.lstrip()
    return t.startswith("//") or t.startswith("/*") or t.startswith("*")


def is_control(s):
    return bool(CONTROL_RE.match(s.lstrip()))


def is_decl(s):
    t = s.lstrip()
    if CONTROL_RE.match(t) or HEADER_RE.match(t) or CASE_RE.match(t):
        return False
    if t.startswith("}") or t.startswith("{"):
        return False
    return bool(DECL_RE.match(s))


def decl_name(s):
    m = DECL_RE.match(s)
    return m.group("name") if m else None


def is_designated_initializer_start(s):
    """True for declaration lines like `OBJECT object = {`."""
    code = strip_code(s).rstrip()
    return is_decl(s) and code.endswith("{") and "=" in code


def is_data_alias(s):
    """Keep `struct TYPE *x = object.data;` attached to the object above it."""
    return bool(re.search(r"=\s*[A-Za-z_]\w*\.data\s*;\s*$", strip_code(s)))


def depths(lines):
    """Paren/bracket/brace depth at the START of each line."""
    res = []
    paren = brack = brace = 0
    in_block = False
    for ln in lines:
        code = strip_code(ln)
        if in_block:
            end = code.find("*/")
            if end == -1:
                res.append((paren, brack, brace))
                continue
            code = code[end + 2 :]
            in_block = False
        while True:
            start = code.find("/*")
            if start == -1:
                break
            end = code.find("*/", start + 2)
            if end == -1:
                code = code[:start]
                in_block = True
                break
            code = code[:start] + code[end + 2 :]
        res.append((paren, brack, brace))
        paren += code.count("(") - code.count(")")
        brack += code.count("[") - code.count("]")
        brace += code.count("{") - code.count("}")
    return res


def collapse(lines):
    out = []
    blanks = 0
    for ln in lines:
        if is_blank(ln):
            blanks += 1
            if blanks <= 2:
                out.append("")
            continue
        blanks = 0
        out.append(ln.rstrip())
    while out and is_blank(out[0]):
        out.pop(0)
    while out and is_blank(out[-1]):
        out.pop()
    return out


def continuation_blocked(prev, cur, dprev, dcur):
    if dcur[0] != 0 or dcur[1] != 0 or dprev[0] != 0 or dprev[1] != 0:
        return True
    ps, cs = prev.rstrip(), cur.lstrip()
    if ps.endswith("\\"):
        return True
    if ps != "" and not ps.endswith((";", "{", "}", ":")):
        return True
    if cs.startswith(CONT_START):
        return True
    return False


def prev_decl_run_names(lines, idx):
    names = []
    j = idx - 1
    while j >= 0 and len(names) < 12:
        s = lines[j]
        if is_blank(s) or is_preproc(s) or is_comment_only(s):
            break
        t = s.lstrip()
        if t.startswith(("{", "}", "#")) or HEADER_RE.match(t) or CASE_RE.match(t):
            break
        if not is_decl(s) or not s.rstrip().endswith(";"):
            break
        nm = decl_name(s)
        if nm:
            names.append(nm)
        j -= 1
    return names


def null_guard_lines(lines):
    """Original indices of 'if (!p)' / 'if (p == NULL)' null guards whose body
    is a single return: they stay glued to the alloc above them."""
    glued = set()
    for k, ln in enumerate(lines):
        if is_blank(ln) or not ln.lstrip().startswith("if"):
            continue
        j = k - 1
        while j >= 0 and is_blank(lines[j]):
            j -= 1
        if j < 0 or not is_decl(lines[j]):
            continue
        names = prev_decl_run_names(lines, k)
        m = re.match(r"^if\s*\(\s*!?\s*\(?\s*([A-Za-z_]\w*)", ln.lstrip())
        if not m or m.group(1) not in names:
            continue
        if "NULL" not in ln and "!" not in ln.split("//")[0]:
            continue
        n = k + 1
        while n < len(lines) and is_blank(lines[n]):
            n += 1
        if n < len(lines) and lines[n].lstrip().startswith("return"):
            glued.add(k)
    return glued


def needs_blank_before(lines, i, dlist, glued=False):
    cur = lines[i]
    if is_blank(cur) or is_preproc(cur) or is_comment_only(cur):
        return False
    ct = cur.lstrip()
    if ct.startswith("}") or ct.startswith("{") or ct == ";" or ct.startswith(";"):
        return False
    if re.match(r"^else\b", ct):
        return False
    m_while = re.match(r"^while\b", ct)
    if m_while and ct.rstrip().endswith(";"):
        return False
    if CASE_RE.match(ct):
        return False
    j = i - 1
    while j >= 0 and is_blank(lines[j]):
        j -= 1
    if j < 0:
        return False
    prev = lines[j]
    if is_preproc(prev) or is_comment_only(prev):
        return False
    pt = prev.lstrip()
    if pt.endswith("{") or pt == "{":
        return False
    if pt.endswith(":"):
        return False
    if HEADER_RE.match(pt) and (pt.endswith(")") or pt in ("else", "do")):
        return False
    if continuation_blocked(prev, cur, dlist[j], dlist[i]):
        return False

    # Give object-style / designated aggregate initializers their own paragraph.
    # This turns a compact declaration run into the more open style used by Pony.
    if is_designated_initializer_start(cur):
        return True

    if pt.startswith("}"):
        # Keep the typed alias to `object.data` directly under the object it belongs to.
        if pt.startswith("};") and is_data_alias(cur):
            return False
        return True
    if is_control(cur):
        if glued:
            return False
        return True
    if is_decl(cur) and not is_decl(prev):
        return True
    if not is_decl(cur) and not is_control(cur) and is_decl(prev):
        code = strip_code(cur).split("//")[0]
        for nm in prev_decl_run_names(lines, i):
            if re.search(r"\b" + re.escape(nm) + r"\b", code):
                return False
        return True
    return False


def airy_pass(text):
    lines = collapse(text.split("\n"))
    if not lines:
        return "\n"
    dlist = depths(lines)
    glued = null_guard_lines(lines)
    out = []
    dout = []
    for i, ln in enumerate(lines):
        if i > 0 and out and not is_blank(out[-1]):
            if needs_blank_before(out + [ln], len(out), dout + [dlist[i]], i in glued):
                out.append("")
                dout.append(dout[-1])
        out.append(ln)
        dout.append(dlist[i])
    return "\n".join(out) + "\n"


def normalize_dependency_includes(text):
    """Repair dependency-sensitive include orders the old formatter could break."""
    lines = text.splitlines(True)
    nri = None
    extensions = []
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "#include <NRI.h>":
            nri = i
        elif stripped.startswith("#include <Extensions/NRI"):
            extensions.append(i)

    if nri is not None and extensions and nri > min(extensions):
        nri_line = lines.pop(nri)
        first_extension = next(
            i for i, line in enumerate(lines)
            if line.strip().startswith("#include <Extensions/NRI")
        )
        lines.insert(first_extension, nri_line)

    return "".join(lines)


def _find_matching_brace(text, open_index):
    """Find the matching } while ignoring comments and string/char literals."""
    depth = 0
    quote = None
    in_line_comment = False
    in_block_comment = False
    i = open_index

    while i < len(text):
        c = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""

        if in_line_comment:
            if c == "\n":
                in_line_comment = False
            i += 1
            continue

        if in_block_comment:
            if c == "*" and nxt == "/":
                in_block_comment = False
                i += 2
                continue
            i += 1
            continue

        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue

        if c in ("'", '"'):
            quote = c
            i += 1
            continue
        if c == "/" and nxt == "/":
            in_line_comment = True
            i += 2
            continue
        if c == "/" and nxt == "*":
            in_block_comment = True
            i += 2
            continue

        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i
        i += 1

    return None


def _split_top_level_initializer_items(content):
    """Split `{ .a = ..., .b = ... }` at commas belonging to that brace only."""
    items = []
    start = 0
    paren = bracket = brace = 0
    quote = None
    in_line_comment = False
    in_block_comment = False
    i = 0

    while i < len(content):
        c = content[i]
        nxt = content[i + 1] if i + 1 < len(content) else ""

        if in_line_comment:
            if c == "\n":
                in_line_comment = False
            i += 1
            continue

        if in_block_comment:
            if c == "*" and nxt == "/":
                in_block_comment = False
                i += 2
                continue
            i += 1
            continue

        if quote:
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue

        if c in ("'", '"'):
            quote = c
            i += 1
            continue
        if c == "/" and nxt == "/":
            in_line_comment = True
            i += 2
            continue
        if c == "/" and nxt == "*":
            in_block_comment = True
            i += 2
            continue

        if c == "(":
            paren += 1
        elif c == ")":
            paren -= 1
        elif c == "[":
            bracket += 1
        elif c == "]":
            bracket -= 1
        elif c == "{":
            brace += 1
        elif c == "}":
            brace -= 1
        elif c == "," and paren == 0 and bracket == 0 and brace == 0:
            item = content[start:i]
            j = i + 1
            while j < len(content) and content[j] in " \t":
                j += 1

            # Preserve a same-line trailing // comment on the field before it.
            trailing_comment = ""
            if content.startswith("//", j):
                end = content.find("\n", j)
                if end == -1:
                    trailing_comment = content[j:]
                    start = len(content)
                    i = len(content)
                else:
                    trailing_comment = content[j:end]
                    start = end + 1
                    i = end
            else:
                start = i + 1

            items.append((item, True, trailing_comment))

        i += 1

    if start < len(content):
        items.append((content[start:], False, ""))

    return items


def _item_begins_with_designator(item):
    """Ignore comment-only lines and look for `.field =` at item scope."""
    for line in item.splitlines():
        t = line.strip()
        if not t or t.startswith("//") or t.startswith("/*") or t.startswith("*"):
            continue
        return bool(re.match(r"^\.[A-Za-z_]\w*\s*=", t))
    return False


def _has_direct_designator(content):
    return any(
        _item_begins_with_designator(item)
        for item, _had_comma, _comment in _split_top_level_initializer_items(content)
    )


def _normalize_initializer_item(item):
    """Undo clang's opening-brace alignment for fields we are about to block-indent."""
    lines = item.strip().splitlines()
    if len(lines) <= 1:
        return item.strip()
    return "\n".join(line.strip() if line.strip() else "" for line in lines)


def _format_nested_initializer_braces(text, base_indent):
    """Expand designated braces nested in one initializer field."""
    out = []
    i = 0

    while i < len(text):
        c = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""

        if c in ("'", '"'):
            quote = c
            j = i + 1
            while j < len(text):
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == quote:
                    j += 1
                    break
                j += 1
            out.append(text[i:j])
            i = j
            continue

        if c == "/" and nxt == "/":
            end = text.find("\n", i)
            if end == -1:
                out.append(text[i:])
                break
            out.append(text[i : end + 1])
            i = end + 1
            continue

        if c == "/" and nxt == "*":
            end = text.find("*/", i + 2)
            if end == -1:
                out.append(text[i:])
                break
            out.append(text[i : end + 2])
            i = end + 2
            continue

        if c == "{":
            close = _find_matching_brace(text, i)
            if close is None:
                out.append(text[i:])
                break

            content = text[i + 1 : close]
            if _has_direct_designator(content):
                out.append(_render_designated_brace(content, base_indent))
            else:
                # Keep scalar/vector lists compact, but still inspect deeper compound literals.
                inner = _format_nested_initializer_braces(content, base_indent)
                out.append("{" + inner + "}")
            i = close + 1
            continue

        out.append(c)
        i += 1

    return "".join(out)


def _render_designated_brace(content, base_indent):
    """Render one designated initializer as an indented block."""
    item_indent = base_indent + "    "
    rendered = []

    for raw, had_comma, trailing_comment in _split_top_level_initializer_items(content):
        raw = raw.strip()
        if not raw:
            continue

        item = _normalize_initializer_item(raw)
        item = _format_nested_initializer_braces(item, item_indent)
        lines = item.splitlines() or [item]

        block = item_indent + lines[0].strip()
        for line in lines[1:]:
            if not line.strip():
                block += "\n"
            elif line.startswith(item_indent):
                block += "\n" + line
            else:
                block += "\n" + item_indent + line.strip()

        if had_comma:
            block += ","
        if trailing_comment:
            block += " " + trailing_comment.strip()
        rendered.append(block)

    return "{\n" + "\n".join(rendered) + "\n" + base_indent + "}"


def _format_designated_chunk(text):
    """Format designated initializers in text that contains no preprocessor directives."""
    out = []
    i = 0

    while i < len(text):
        c = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""

        if c in ("'", '"'):
            quote = c
            j = i + 1
            while j < len(text):
                if text[j] == "\\":
                    j += 2
                    continue
                if text[j] == quote:
                    j += 1
                    break
                j += 1
            out.append(text[i:j])
            i = j
            continue

        if c == "/" and nxt == "/":
            end = text.find("\n", i)
            if end == -1:
                out.append(text[i:])
                break
            out.append(text[i : end + 1])
            i = end + 1
            continue

        if c == "/" and nxt == "*":
            end = text.find("*/", i + 2)
            if end == -1:
                out.append(text[i:])
                break
            out.append(text[i : end + 2])
            i = end + 2
            continue

        if c == "{":
            close = _find_matching_brace(text, i)
            if close is None:
                out.append(text[i:])
                break

            content = text[i + 1 : close]
            if _has_direct_designator(content):
                line_start = text.rfind("\n", 0, i) + 1
                prefix = text[line_start:i]
                base_indent = re.match(r"[ \t]*", prefix).group(0)
                out.append(_render_designated_brace(content, base_indent))
            else:
                inner = _format_designated_chunk(content)
                out.append("{" + inner + "}")
            i = close + 1
            continue

        out.append(c)
        i += 1

    return "".join(out)


def expand_designated_initializers(text):
    """Force C designated initializers into a readable block form.

    Examples:
      OBJECT x = {.state = STATIC, .type = MODEL};

    becomes:
      OBJECT x = {
          .state = STATIC,
          .type = MODEL
      };

    Short scalar/vector braces such as `{0}` and `{1.0f, 2.0f, 3.0f}` remain
    compact. Preprocessor directives are passed through untouched so multiline
    macros cannot be broken by this pass.
    """
    lines = text.splitlines(True)
    out = []
    normal = []
    i = 0

    def flush_normal():
        if normal:
            out.append(_format_designated_chunk("".join(normal)))
            normal.clear()

    while i < len(lines):
        line = lines[i]
        if line.lstrip().startswith("#"):
            flush_normal()
            directive = [line]
            while directive[-1].rstrip("\r\n").endswith("\\") and i + 1 < len(lines):
                i += 1
                directive.append(lines[i])
            out.extend(directive)
        else:
            normal.append(line)
        i += 1

    flush_normal()
    return "".join(out)


def run_clang_format(text, filename, exe="clang-format"):
    cmd = [
        exe,
        "--sort-includes=0",
        "--style=" + FELIX_STYLE,
        "--assume-filename=" + os.path.abspath(filename),
    ]
    try:
        p = subprocess.run(
            cmd, input=text, capture_output=True, text=True,
            cwd=os.path.dirname(os.path.abspath(filename)) or ".",
        )
    except FileNotFoundError:
        print(f"felix-format: '{exe}' not found (use --no-clang)", file=sys.stderr)
        sys.exit(2)
    if p.returncode != 0:
        print(f"felix-format: clang-format failed on {filename}:\n{p.stderr}", file=sys.stderr)
        sys.exit(2)
    return p.stdout


def format_text(text, filename, use_clang=True, clang_exe="clang-format"):
    text = normalize_dependency_includes(text)
    if use_clang:
        text = run_clang_format(text, filename, clang_exe)
    text = expand_designated_initializers(text)
    return airy_pass(text)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="felix-format", description="clang-format + airy paragraph spacing")
    ap.add_argument("-i", "--in-place", action="store_true", help="edit files in place")
    ap.add_argument("--check", action="store_true", help="exit 1 if any file would change")
    ap.add_argument("--diff", action="store_true", help="show unified diffs")
    ap.add_argument("--no-clang", action="store_true", help="skip clang-format, custom passes only")
    ap.add_argument("--clang-format", default="clang-format", help="clang-format binary")
    ap.add_argument("files", nargs="*", help="C files (shell expands *.c)")
    args = ap.parse_args(argv)

    if not args.files:
        if sys.stdin.isatty():
            ap.print_help()
            return 2
        sys.stdout.write(format_text(sys.stdin.read(), "stdin.c", not args.no_clang, args.clang_format))
        return 0

    results = []
    rc = 0
    for path in args.files:
        try:
            with open(path, "r", encoding="utf-8") as f:
                orig = f.read()
        except OSError as e:
            print(f"felix-format: cannot read {path}: {e}", file=sys.stderr)
            rc = 2
            continue
        new = format_text(orig, path, not args.no_clang, args.clang_format)
        results.append((path, orig, new))

    changed = [(p, o, n) for p, o, n in results if o != n]

    if args.check:
        for p, _o, _n in changed:
            print(f"would reformat: {p}")
        return 1 if changed else rc

    if args.in_place:
        for p, _o, n in changed:
            with open(p, "w", encoding="utf-8") as f:
                f.write(n)
        return rc

    if args.diff or len(results) > 1:
        for p, o, n in changed:
            sys.stdout.write("".join(difflib.unified_diff(
                o.splitlines(True), n.splitlines(True),
                fromfile=p + " (orig)", tofile=p + " (felix)")))
        return rc

    sys.stdout.write(results[0][2])
    return rc


if __name__ == "__main__":
    sys.exit(main())

